                android:background="@color/azul"
                android:layout_marginTop="30dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/hola_mundo"
                android:textColor="@color/white"
                android:background="@color/azul"
                android:layout_marginTop="30dp"/>

